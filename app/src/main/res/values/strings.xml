    <string name="about_title">Acerca de CarpStrategy</string>
    <string name="about_description">App personal y no comercial: diario de sesiones de pesca de carpa y estimador de condiciones a partir del tiempo de los días anteriores y del día de pesca. No localiza peces: indica condiciones más o menos favorables según la evidencia disponible y tus propios datos.</string>
    <string name="about_sources_title">Fuentes de datos</string>
    <string name="about_source_openmeteo">Datos meteorológicos de Open-Meteo.com (licencia CC BY 4.0), con los modelos ICON-EU (DWD), ARPEGE Europe (Météo-France) e IFS (ECMWF).</string>
    <string name="about_source_aemet">Observaciones: © AEMET (Agencia Estatal de Meteorología), AEMET OpenData.</string>
    <string name="about_disclaimers_title">Limitaciones</string>
    <string name="about_disclaimer_water">La temperatura del agua NO se mide desde la app: salvo que introduzcas tu propia medición (recomendado), es una estimación a partir de la temperatura del aire de los últimos días.</string>
    <string name="about_disclaimer_rules">Cada indicación muestra su nivel de evidencia: 🟢 fuerte · 🟡 moderada/hipótesis · 🔴 mito o insuficiente (peso 0) · 🟣 hipótesis local pendiente de validar · 🔵 variabilidad individual.</string>
    <string name="about_disclaimer_legal">En Brovales solo es legal pescar desde 1 h antes de la salida del sol hasta 1 h después de su puesta. Revisa la normativa vigente (DOE y pescayrios.juntaextremadura.es) antes de cada temporada.</string>
    <string name="about_aemet_key_missing">No hay API key de AEMET configurada: no se usarán observaciones reales.</string>
    <string name="about_aemet_key_present">API key de AEMET configurada.</string>
    <string name="about_version">Versión %1$s</string>

